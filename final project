int jankenPon() {
    int lives = 3;
    int option;
    char userChoice, computerChoice;
    int choiceJP = 1;

    cout << "\n==================== JANKEN PON ====================\n"
         << "Play Rock-Paper-Scissors against the computer.\n"
         << "Win to earn 1 point. Draws do not affect points or lives.\n"
         << "You have 3 lives. Good luck!\n";

    do {
        cout << "\n1. Start the game\n"
             << "0. Back to main menu\n"
             << "\nChoose an option: ";
        cin >> option;
        if (option < 0 || option > 1) {
            cout << "Invalid choice. Please try again.\n";
        }
    } while (option < 0 || option > 1);

    if (option == 0) {
        return 2;
    }

    while (choiceJP == 1 && lives > 0) {
        cout << "\nLives: " << lives
             << "\nChoose Rock (r), Paper (p), or Scissors (s): ";
        cin >> userChoice;

        cout << "\nJan..." << flush;
        this_thread::sleep_for(chrono::seconds(1));

        cout << " Ken..." << flush;
        this_thread::sleep_for(chrono::seconds(1));

        cout << " Pon!\n" << flush;
        this_thread::sleep_for(chrono::seconds(1));

        int computerRandom = rand() % 3;
        if (computerRandom == 0) {
            computerChoice = 'r';
        } else if (computerRandom == 1) {
            computerChoice = 'p';
        } else {
            computerChoice = 's';
        }

        cout << "Computer chose: " << computerChoice << "\n";

        if (userChoice == computerChoice) {
            cout << "It's a draw!\n";
        } else if ((userChoice == 'r' && computerChoice == 's') ||
                   (userChoice == 'p' && computerChoice == 'r') ||
                   (userChoice == 's' && computerChoice == 'p')) {
            cout << "You win!\n";
            points += 1;
            jankenPonPoints += 1;
        } else {
            cout << "You lose!\n";
            lives--;
        }
    }

    return 0;
}

