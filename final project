int bloomMath() {
    int option;
    int level = 1;
    int lives = 3;
    int choiceBM = 2; // Show the difficulty menu first.

    cout << "\n==================== BLOOM MATH ====================\n"
         << "Welcome to Bloom Math! Solve a problem to help your flower bloom.\n"
         << "1 point for each Easy problem solved.\n"
         << "2 points for each Medium problem solved.\n"
         << "3 points for each Hard problem solved.\n"
         << "Get 15 correct answers before losing all 3 lives.\n"
         << "IMPORTANT NOTE: only lowercase answers is considered as correct answer";

    do {
        cout << "\n1. Start the game\n"
             << "0. Back to main menu\n"
             << "\nChoose an option: ";
        cin >> option;
        if (option < 0 || option > 1) {
            cout << "Invalid choice. Please try again.\n";
        }
    } while (option < 0 || option > 1);

    if (option == 0) {
        return 3;
    }

    while (choiceBM == 1 || choiceBM == 2) {
        if (choiceBM == 2) {
            do {
                cout << "1. Easy\n"
                     << "2. Medium\n"
                     << "3. Hard\n"
                     << "\nChoose a difficulty level: ";

                cin >> level;
                if (level < 1 || level > 3) {
                    cout << "Invalid level. Please try again.\n\n";
                }
            } while (level < 1 || level > 3);
        }

        switch (level) {
            case 1:
                lives = bloomMathEasy();
                break;
            case 2:
                lives = bloomMathMedium();
                break;
            case 3:
                lives = bloomMathHard();
                break;
        }

        choiceBM = gameOverBM(lives);
    }

    return choiceBM; // 0 = exit; 3 = return to the main menu.
}

int revealCluePW() {
    string decision;
    int choice = -1;

    do {
        cout << "\nReveal next clue? (y/n): ";
        cin >> decision;

        if (decision == "y") {
            choice = 1;
        } else if (decision == "n") {
            choice = 0;
        } else {
            cout << "Invalid input. Please enter 'y' or 'n'.\n";
        }
    } while (choice < 0);

    return choice;
}

int QnAPW() {
